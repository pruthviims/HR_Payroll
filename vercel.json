{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/payroll/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/payroll",
      "destination": "/index.html"
    },
    {
      "source": "/payroll/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets|favicon.ico|src|api).*)",
      "destination": "/index.html"
    }
  ]
}
