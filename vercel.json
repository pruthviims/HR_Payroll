{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/payroll/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/payroll/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/payroll/(.*)",
      "destination": "/index.html"
    }
  ]
}
