{
  "rewrites": [
    {
      "source": "/payroll/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/payroll/((?!assets/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/payroll",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
